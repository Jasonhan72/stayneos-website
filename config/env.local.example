# Copy to .env.local for local Next.js development; never commit real values.
# Cloudflare D1 is provided by the DB binding, not by DATABASE_URL.
NEXTAUTH_URL=http://localhost:3000
# Generate a local secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXTAUTH_SECRET=

# Public build-time values. Use a referrer-restricted development Maps key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe test mode only for local integration tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional email integration. Keep empty unless deliberately testing delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@stayneos.com
HOST_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Optional Google OAuth development application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Legacy Prisma tooling only; the deployed application uses D1.
DATABASE_URL=
DIRECT_URL=
